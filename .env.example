# ---------------------------------------------------------------------------
# RVRH Enterprises LLC — Environment Variables
# Copy this file to `.env.local` and fill in the values you need.
# ---------------------------------------------------------------------------

# Public site URL used for canonical URLs, sitemap, robots, and Open Graph.
# No trailing slash. Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://www.rvrhenterprises.com

# ---------------------------------------------------------------------------
# Contact form email delivery (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# If these are NOT set, the contact form falls back to a development mode that
# logs the validated submission to the server console instead of emailing.

# Resend API key (server-side only — never exposed to the browser).
RESEND_API_KEY=

# Where property inquiries are delivered.
CONTACT_TO_EMAIL=rhofert@yahoo.com

# The "from" address. Must be a domain you have verified in Resend.
# Example: RVRH Enterprises <inquiries@yourdomain.com>
CONTACT_FROM_EMAIL=
